pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/numanpathan/Dockerproject.git'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t $image .'
            }
        }

        stage('tag') {
            steps {
                sh 'docker tag $image $repo'
            }
        }

        stage('push') {
            steps {
                sh 'docker login -u numan009 -p $password'
                sh 'docker push $repo'
            }
        }
    }
}
